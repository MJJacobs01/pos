<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme. NoActionBar + edge-to-edge; all UI styling is handled by
         Jetpack Compose (PosTheme). The transparent system bars and window
         background prevent a launch flash before Compose draws. -->
    <style name="Theme.POS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

</resources>
